# FlowSync Backend Environment

FLOWSYNC_ENV=local
FLOWSYNC_APP_NAME=FlowSync Smart Mobility Backend
FLOWSYNC_API_VERSION=1.0.1

# Server
FLOWSYNC_HOST=127.0.0.1
FLOWSYNC_PORT=8000

# CORS
FLOWSYNC_CORS_ORIGINS=*

# Routing / geocoding provider foundation
FLOWSYNC_ROUTING_PROVIDER=mock
FLOWSYNC_GEOCODING_PROVIDER=sqlite
FLOWSYNC_ROUTING_API_KEY=
FLOWSYNC_GEOCODING_API_KEY=
FLOWSYNC_ROUTING_BASE_URL=
FLOWSYNC_GEOCODING_BASE_URL=
FLOWSYNC_MOCK_FALLBACK=true

# Database
DATABASE_URL=

# Optional real map provider mode
# To enable real OpenRouteService integration:
# FLOWSYNC_ROUTING_PROVIDER=openrouteservice
# FLOWSYNC_GEOCODING_PROVIDER=openrouteservice
# FLOWSYNC_ROUTING_API_KEY=your_openrouteservice_key_here
# FLOWSYNC_GEOCODING_API_KEY=your_openrouteservice_key_here
# OPENROUTESERVICE_API_KEY=your_openrouteservice_key_here